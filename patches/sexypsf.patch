new file mode 100644
index 0000000..67de606
--- /dev/null
+++ b/CMakeLists.txt
@@ -0,0 +1,30 @@
+# CMakeLists.txt for SexyPSF
+project(sexypsf)
+
+set(SEXYPSF_SOURCES
+    PsxBios.c
+    PsxCounters.c
+    PsxDma.c
+    Spu.c
+    PsxHw.c
+    PsxMem.c
+    Misc.c
+    R3000A.c
+    PsxInterpreter.c
+    PsxHLE.c
+    spu/spu.c
+)
+
+add_library(sexypsf STATIC ${SEXYPSF_SOURCES})
+
+target_compile_definitions(sexypsf PRIVATE
+    PSS_STYLE=1
+    SPSFVERSION="0.4.8"
+    LSB_FIRST
+)
+
+target_include_directories(sexypsf PUBLIC . spu)
+
+# SexyPSF needs zlib
+find_package(ZLIB REQUIRED)
+target_link_libraries(sexypsf PRIVATE ZLIB::ZLIB)
