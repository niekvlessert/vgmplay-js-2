+uint32_t
+SNG_setMask (SNG * sng, uint32_t mask)
+{
+  uint32_t ret = 0;
+  if (sng)
+  {
+    ret = sng->mask;
+    sng->mask = mask;
+    sng->mute[0] = (mask & 0x01) ? 1 : 0;
+    sng->mute[1] = (mask & 0x02) ? 1 : 0;
+    sng->mute[2] = (mask & 0x04) ? 1 : 0;
+  }
+  return ret;
+}
